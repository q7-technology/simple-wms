# Copy to .env and fill in. Nothing here is committed.

# Postgres (used by the db, api and worker containers)
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me
# Host port the database is published on (127.0.0.1 only)
POSTGRES_PORT=5432

# API
# Random string, at least 32 characters. Used to sign session tokens.
WMS_SECRET_KEY=change-me-to-a-long-random-string
# How long a repeated message_id returns the original reply
WMS_MESSAGE_TTL_HOURS=24

# Caddy: the public host name. "localhost" gives a self-signed local cert.
WMS_DOMAIN=localhost

# Host port the API is published on, for local work and health checks.
# Caddy is still the only door from outside.
WMS_API_PORT=8000

# Nightly backups: how many days of dumps to keep in the `backups` volume.
BACKUP_KEEP_DAYS=14
